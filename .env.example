# Hindsight memory configuration
HINDSIGHT_BASE_URL=https://api.hindsight.example.com
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Groq LLM underwriter configuration
GROQ_API_KEY=your_groq_api_key_here

# Optional admin key protection (if set, requires X-API-Key header on /import/*, /sim/run, /loans/{id}/resolve)
ADMIN_KEY=dev-secret-admin-key
NEXT_PUBLIC_ADMIN_KEY=dev-secret-admin-key

# Deployment safety
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# When true, public live-loan requests never write decisions or outcomes to Hindsight.
PUBLIC_DEMO=false
# In-process cost guard for live loan, /memory/recall, and /memory/beliefs.
RATE_PER_MIN=8
DAILY_CAP=300
